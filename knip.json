{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,error,loading,not-found,route,template,default}.tsx",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,mts}"],
  "ignore": [
    "src/lib/supabase/**",
    "src/lib/env.ts",
    "src/lib/db/database.types.ts",
    "src/components/ui/**"
  ],
  "ignoreDependencies": ["stripe", "dotenv", "tailwindcss", "shadcn"],
  "ignoreBinaries": ["psql", "supabase"]
}
