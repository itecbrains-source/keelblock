{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,error,loading,not-found,route,template,default}.tsx",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,mts}"],

  "ignore": ["src/lib/supabase/**", "src/lib/env.ts", "src/lib/db/database.types.ts"],
  "ignoreDependencies": [
    "@supabase/ssr",
    "@supabase/supabase-js",
    "server-only",
    "stripe",
    "@testing-library/jest-dom",
    "@testing-library/react",
    "dotenv",
    "tailwindcss"
  ],
  "ignoreBinaries": ["psql", "supabase"]
}
