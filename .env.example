# Copy to .env.local. `supabase start` prints these values.
# .env.local is gitignored; never commit real keys.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security entirely, so it must never be exposed to the browser:
# no NEXT_PUBLIC_ prefix, and only imported from modules under src/lib/supabase/server-only/.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the policy suite and the access matrix generator against the LOCAL stack only.
# rlsautotest seeds rows and executes real queries before rolling back — never point it at production.
KEELBLOCK_DB_URL=postgresql://postgres:postgres@127.0.0.1:54722/postgres

# Comma-separated OAuth providers that are actually configured in supabase/config.toml with their
# secrets set — e.g. "github,google". Empty means no provider button is rendered, which is the
# honest default: a button that always fails is worse than none. (SPEC-004 REQ-7)
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Auth email delivery. Without a custom SMTP server Supabase sends at most 2 auth emails per hour,
# project-wide, and that limit "can only be changed with your own custom SMTP setup". For a product
# that signs in by emailed link that is not a hardening item — it is the third sign-in of the hour
# failing. Configure [auth.email.smtp] in supabase/config.toml and set the secret here.
# (SPEC-004 REQ-9)
SMTP_PASSWORD=

# ── Stripe (SPEC-007) ────────────────────────────────────────────────────────
# TEST/SANDBOX KEYS ONLY, and not from an account that bills anyone real. Stripe accounts carry test
# and live modes with separate keys and separate data, so no live credential is ever needed here.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen --forward-to localhost:3000/api/stripe`, not the dashboard. A deployed endpoint
# has a different secret. Verification is over the raw request body (Stripe rejects a modified one),
# with a 5-minute timestamp tolerance against replay.
STRIPE_WEBHOOK_SECRET=
